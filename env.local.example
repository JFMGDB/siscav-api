# SISCAV API — template para desenvolvimento local
#
#   cp env.local.example .env.local
#   Edite DATABASE_URL e SECRET_KEY. Não commite .env.local.
#
# A API carrega .env.local automaticamente em dev (ENVIRONMENT != production).
# Outros bancos (Docker, SQLite): docs/setup/env-alternatives.md

ENVIRONMENT=development

# Supabase — pooler session mode, porta 5432, sslmode=require
# Dashboard > Project Settings > Database > Connect (host IPv4, ex. aws-1-sa-east-1...)
# Senha com caracteres especiais na URL: encode (? → %3F, @ → %40, % → %25)
DATABASE_URL=postgresql+psycopg2://postgres.[PROJECT_REF]:[PASSWORD_URL_ENCODED]@aws-1-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require

# JWT (gere SECRET_KEY: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change_me_in_development
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Vazio em dev: POST /api/v1/access_logs/ sem cabeçalho X-Device-Key
DEVICE_INGEST_KEY=

# CORS — em produção, configure no Render com a URL estável da Vercel.
# Ex.: BACKEND_CORS_ORIGINS=https://siscav-web.vercel.app
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Uploads — Render free tier usa filesystem efêmero.
# Ex. free tier: UPLOAD_DIR=/tmp/siscav-uploads
# Ex. plano pago com persistent disk: UPLOAD_DIR=/opt/uploads
UPLOAD_DIR=uploads

# Vehicle classifier (default: stub — no ONNX). For local ONNX inference:
# VEHICLE_CLASSIFIER_BACKEND=onnx
# VEHICLE_CLASSIFIER_MODEL_PATH=models/ambulance_classifier.onnx
# VEHICLE_CLASSIFIER_THRESHOLD=0.60
# VEHICLE_CLASSIFIER_LABELS=ambulance,other
# VEHICLE_CLASSIFIER_INPUT_SIZE=224
