# .env.supabase — copie para .env.local na raiz do siscav-api (auto-carregado ao iniciar a API em dev).
ENVIRONMENT=development

# Pooler session mode (port 5432): recommended for this API + Alembic migrations.
# Transaction mode (port 6543, ?pgbouncer=true) is for high-volume/serverless; if used for the app,
# keep a separate session-mode URL for migrations (see docs/architecture/adr/003-database-url-and-supabase-exposure.md).
# Prefer IPv4 pooler host from Supabase Dashboard > Connect (e.g. aws-1-sa-east-1).
# URL-encode special characters in the password (? -> %3F, @ -> %40, % -> %25).
DATABASE_URL=postgresql+psycopg2://postgres.[PROJECT_REF]:[PASSWORD_URL_ENCODED]@aws-1-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require

SECRET_KEY=...
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60